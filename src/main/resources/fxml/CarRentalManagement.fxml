<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox alignment="TOP_CENTER"
      spacing="15"
      xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fucar.gui.controller.CarRentalManagementController">

    <!-- TITLE -->
    <Label text="Car Rental Management"
           style="-fx-font-size: 22px; -fx-font-weight: bold"/>

    <!-- RENTAL TABLE -->
    <TableView fx:id="rentalTable" prefWidth="750" prefHeight="350">

        <columns>
            <TableColumn fx:id="colRentalID"
                         text="Rental ID"
                         prefWidth="80"/>

            <TableColumn fx:id="colCustomer"
                         text="Customer"
                         prefWidth="150"/>

            <TableColumn fx:id="colCar"
                         text="Car"
                         prefWidth="150"/>

            <TableColumn fx:id="colStartDate"
                         text="Start Date"
                         prefWidth="120"/>

            <TableColumn fx:id="colEndDate"
                         text="End Date"
                         prefWidth="120"/>
        </columns>
    </TableView>

    <!-- BUTTONS -->
    <HBox spacing="20" alignment="CENTER">
        <Button fx:id="btnAddRental"
                text="Add Rental"
                style="-fx-padding: 8 20"/>

        <Button fx:id="btnEditRental"
                text="Edit Rental"
                style="-fx-padding: 8 20"/>

        <Button fx:id="btnDeleteRental"
                text="Delete Rental"
                style="-fx-padding: 8 20"/>
    </HBox>

</VBox>
