<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox alignment="TOP_CENTER"
      spacing="15"
      padding="20"
      xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fucar.gui.controller.CarRentalManagementController"
      VBox.vgrow="ALWAYS">

    <!-- TITLE -->
    <Label text="Car Rental Management"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <!-- RENTAL TABLE -->
    <TableView fx:id="rentalTable" prefHeight="400" VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="colRentalID"
                         text="Rental ID"
                         prefWidth="70"/>

            <TableColumn fx:id="colCustomer"
                         text="Customer"
                         prefWidth="120"/>

            <TableColumn fx:id="colCar"
                         text="Car"
                         prefWidth="120"/>

            <TableColumn fx:id="colStartDate"
                         text="Start Date"
                         prefWidth="100"/>

            <TableColumn fx:id="colEndDate"
                         text="End Date"
                         prefWidth="100"/>

            <TableColumn fx:id="colStatus"
                         text="Status"
                         prefWidth="90"/>

            <TableColumn fx:id="colPrice"
                         text="Total Price"
                         prefWidth="100"/>
        </columns>
    </TableView>

    <!-- BUTTONS -->
    <HBox spacing="10" style="-fx-alignment: CENTER;">
        <Button fx:id="btnApprove"
                text="✓ Approve"
                style="-fx-padding: 10 20; -fx-background-color: #27ae60; -fx-text-fill: white;"/>

        <Button fx:id="btnReject"
                text="✗ Reject"
                style="-fx-padding: 10 20; -fx-background-color: #e67e22; -fx-text-fill: white;"/>

        <Button fx:id="btnDelete"
                text="🗑 Delete"
                style="-fx-padding: 10 20; -fx-background-color: #e74c3c; -fx-text-fill: white;"/>

        <Pane HBox.hgrow="ALWAYS"/>

        <Button fx:id="btnRefresh"
                text="Refresh"
                style="-fx-padding: 10 20; -fx-background-color: #95a5a6; -fx-text-fill: white;"/>
    </HBox>

</VBox>
