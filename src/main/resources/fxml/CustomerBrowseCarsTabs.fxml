<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fucar.browsecars.BrowseCarsController"
      spacing="15"
      style="-fx-padding: 20;"
      VBox.vgrow="ALWAYS">

    <!-- TITLE AND SEARCH SECTION -->
    <VBox spacing="10">
        <Label text="Browse Cars"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <!-- SEARCH AND FILTER BAR -->
        <HBox spacing="10" style="-fx-padding: 10; -fx-background-color: #ecf0f1; -fx-border-radius: 5;">
            <Label text="Search:" style="-fx-text-fill: #333;"/>
            <TextField fx:id="txtSearch"
                       promptText="Search by car name or producer..."
                       style="-fx-padding: 8; -fx-border-radius: 3;"
                       HBox.hgrow="ALWAYS"/>

            <Label text="Filter:" style="-fx-text-fill: #333;"/>
            <ComboBox fx:id="cmbFilter"
                      style="-fx-padding: 8; -fx-border-radius: 3;"
                      prefWidth="120"
                      onAction="#handleFilterChange"/>

            <Button text="Search" fx:id="btnSearch"
                    onAction="#handleSearch"
                    style="-fx-padding: 8 20; -fx-background-color: #3498db; -fx-text-fill: white; -fx-border-radius: 3;"/>

            <Button text="Refresh" 
                    onAction="#handleRefresh"
                    style="-fx-padding: 8 20; -fx-background-color: #95a5a6; -fx-text-fill: white; -fx-border-radius: 3;"/>
        </HBox>
    </VBox>

    <!-- MAIN CONTENT AREA -->
    <HBox spacing="15" VBox.vgrow="ALWAYS">
        
        <!-- LEFT SIDE: CARS LIST -->
        <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-min-width: 400;">
            <Label text="Available Cars" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <ScrollPane fx:id="scrollPane"
                        fitToWidth="true"
                        style="-fx-padding: 0;">
                <VBox fx:id="carsContainer"
                      spacing="10"
                      style="-fx-padding: 5;">
                    <!-- Cars will be added here dynamically -->
                </VBox>
            </ScrollPane>
        </VBox>

        <!-- RIGHT SIDE: DETAILS AND RENTAL FORM -->
        <VBox spacing="15" style="-fx-min-width: 450; -fx-border-left: 1 solid #ddd; -fx-padding-left: 20;">
            
            <!-- CAR DETAILS SECTION -->
            <VBox spacing="10" fx:id="detailsSection">
                <Label text="Car Details" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <ScrollPane fitToWidth="true">
                    <VBox spacing="12" style="-fx-padding: 10; -fx-background-color: #f9f9f9; -fx-border-radius: 5;">

                        <!-- CAR INFO GRID -->
                        <GridPane hgap="15" vgap="12">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                <ColumnConstraints halignment="LEFT" minWidth="200" prefWidth="200"/>
                            </columnConstraints>

                            <!-- Car Name -->
                            <Label text="Car Name:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label fx:id="lblCarName" text="Select a car" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <!-- Producer -->
                            <Label text="Producer:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Label fx:id="lblProducer" text="N/A" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <!-- Year -->
                            <Label text="Model Year:" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <Label fx:id="lblYear" text="N/A" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <!-- Color -->
                            <Label text="Color:" style="-fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <Label fx:id="lblColor" text="N/A" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                            <!-- Capacity -->
                            <Label text="Capacity:" style="-fx-font-weight: bold;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <Label fx:id="lblCapacity" text="N/A" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                            <!-- License Plate -->
                            <Label text="License Plate:" style="-fx-font-weight: bold;" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                            <Label fx:id="lblLicensePlate" text="N/A" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                            <!-- Import Date -->
                            <Label text="Import Date:" style="-fx-font-weight: bold;" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                            <Label fx:id="lblImportDate" text="N/A" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                            <!-- Status -->
                            <Label text="Status:" style="-fx-font-weight: bold;" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                            <Label fx:id="lblStatus" text="N/A" style="-fx-font-weight: bold;" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                            <!-- Price -->
                            <Label text="Rental Price:" style="-fx-font-weight: bold; -fx-text-fill: #e74c3c;" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                            <Label fx:id="lblPrice" text="$0.00 / day" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #e74c3c;" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                        </GridPane>

                        <!-- SEPARATOR -->
                        <Separator/>

                        <!-- DESCRIPTION -->
                        <Label text="Description:" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                        <TextArea fx:id="txtDescription"
                                  wrapText="true"
                                  editable="false"
                                  prefRowCount="4"
                                  style="-fx-font-size: 11px; -fx-padding: 8; -fx-border-radius: 3;"/>

                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- RENTAL FORM SECTION -->
            <VBox spacing="12" fx:id="rentalSection">
                <Label text="Rental Booking" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <ScrollPane fitToWidth="true" style="-fx-border: 1 solid #ddd; -fx-border-radius: 5;">
                    <VBox spacing="12" style="-fx-padding: 15; -fx-background-color: #f0f8ff;">

                        <!-- RENTAL DETAILS -->
                        <GridPane hgap="15" vgap="12">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="90" prefWidth="90"/>
                                <ColumnConstraints halignment="LEFT" minWidth="200" prefWidth="200"/>
                            </columnConstraints>

                            <!-- START DATE -->
                            <Label text="Start Date:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <DatePicker fx:id="dpStartDate"
                                        style="-fx-padding: 8; -fx-border-radius: 3;"
                                        GridPane.rowIndex="0"
                                        GridPane.columnIndex="1"/>

                            <!-- END DATE -->
                            <Label text="End Date:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <DatePicker fx:id="dpEndDate"
                                        style="-fx-padding: 8; -fx-border-radius: 3;"
                                        GridPane.rowIndex="1"
                                        GridPane.columnIndex="1"/>

                            <!-- RENTAL DAYS -->
                            <Label text="Rental Days:" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <Spinner fx:id="spinnerDays"
                                     style="-fx-padding: 8; -fx-border-radius: 3;"
                                     prefWidth="200"
                                     GridPane.rowIndex="2"
                                     GridPane.columnIndex="1"/>

                        </GridPane>

                        <!-- PRICE SUMMARY -->
                        <VBox spacing="8" style="-fx-padding: 12; -fx-background-color: #fff9e6; -fx-border-radius: 5; -fx-border-color: #f39c12; -fx-border-width: 1;">
                            <Label fx:id="lblTotalPrice"
                                   text="Total: $0.00 for 0 day(s)"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                            <Label text="This is your estimated total price. Final price will be calculated at confirmation."
                                   style="-fx-font-size: 10px; -fx-text-fill: #666; -fx-wrap-text: true;"/>
                        </VBox>

                        <!-- NOTES -->
                        <VBox spacing="6" style="-fx-padding: 10; -fx-background-color: #fffacd; -fx-border-radius: 5;">
                            <Label text="Important Notes:" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                            <Label text="• Minimum rental period is 1 day" style="-fx-font-size: 10px; -fx-wrap-text: true;"/>
                            <Label text="• Cannot select past dates" style="-fx-font-size: 10px; -fx-wrap-text: true;"/>
                            <Label text="• Rental request needs admin approval" style="-fx-font-size: 10px; -fx-wrap-text: true;"/>
                        </VBox>

                        <!-- ACTION BUTTONS -->
                        <HBox spacing="10">
                            <Pane HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnRent"
                                    text="Book Now"
                                    onAction="#handleRentInline"
                                    style="-fx-padding: 10 30; -fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 12px;"/>
                        </HBox>

                    </VBox>
                </ScrollPane>
            </VBox>

        </VBox>

    </HBox>

</VBox>
