<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fucar.gui.controller.AdminDashboardController">

    <!-- TOP NAVIGATION BAR -->
    <top>
        <HBox spacing="15" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            
            <Label text="⚙ ADMIN CONTROL PANEL"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />

            <!-- MENU BUTTONS -->
            <Button text="Manage Cars"        onAction="#handleCarManagement"
                    style="-fx-background-color: #1abc9c; -fx-text-fill: white;" />
            <Button text="Manage Customers"   onAction="#handleCustomerManagement"
                    style="-fx-background-color: #1abc9c; -fx-text-fill: white;" />
            <Button text="Manage Rentals"     onAction="#handleRentalManagement"
                    style="-fx-background-color: #1abc9c; -fx-text-fill: white;" />
            <Button text="Manage Reviews"     onAction="#handleReviewManagement"
                    style="-fx-background-color: #1abc9c; -fx-text-fill: white;" />

            <!-- Đẩy logout sang góc phải -->
            <Pane HBox.hgrow="ALWAYS" />

            <Button text="Logout" onAction="#handleLogout"
                    style="-fx-background-color: #0097a7; -fx-text-fill: white;" />
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 20;" />
    </center>

</BorderPane>