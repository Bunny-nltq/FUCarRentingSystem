<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fucar.gui.controller.CustomerDashboardController">

    <!-- TOP NAVIGATION -->
    <top>
        <HBox spacing="20" style="-fx-background-color: #2c3e50; -fx-padding: 15;">

            <Label text="🚗 CUSTOMER DASHBOARD"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />

            <!-- MENU BUTTONS -->
            <Button text="Browse Cars"
                    onAction="#handleBrowseCars"
                    style="-fx-background-color: #1abc9c; -fx-text-fill: white;" />

            <Button text="My Rentals"
                    onAction="#handleMyRentals"
                    style="-fx-background-color: #1abc9c; -fx-text-fill: white;" />
                    
            <Button text="Review Car"
                    onAction="#handleReview"
                    style="-fx-background-color: #1abc9c; -fx-text-fill: white;" />

            <Button text="My Profile"
                    onAction="#handleMyProfile"
                    style="-fx-background-color: #1abc9c; -fx-text-fill: white;" />

            <Pane HBox.hgrow="ALWAYS"/>

            <Button text="Logout"
                    onAction="#handleLogout"
                    style="-fx-background-color: #0097a7; -fx-text-fill: white;" />

        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 20;" />
    </center>

</BorderPane>
