<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fucar.gui.controller.CustomerManagementController"
      spacing="15"
      padding="20"
      VBox.vgrow="ALWAYS">

    <Label text="Customer Management"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <TableView fx:id="customerTable" prefHeight="400" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colID" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colName" text="Name" prefWidth="130"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="150"/>
            <TableColumn fx:id="colPhone" text="Phone" prefWidth="100"/>
            <TableColumn fx:id="colBirthday" text="Birthday" prefWidth="100"/>
            <TableColumn fx:id="colIdentityCard" text="ID Card" prefWidth="100"/>
            <TableColumn fx:id="colLicenceNumber" text="License #" prefWidth="100"/>
            <TableColumn fx:id="colLicenceDate" text="License Date" prefWidth="100"/>
        </columns>
    </TableView>

    <HBox spacing="10" style="-fx-alignment: CENTER;">
        <Button text="➕ Add Customer" onAction="#handleAddCustomer" 
                style="-fx-padding: 10 20; -fx-background-color: #27ae60; -fx-text-fill: white;"/>
        <Button text="✎ Edit Customer" onAction="#handleEditCustomer" 
                style="-fx-padding: 10 20; -fx-background-color: #3498db; -fx-text-fill: white;"/>
        <Button text="🗑 Delete Customer" onAction="#handleDeleteCustomer" 
                style="-fx-padding: 10 20; -fx-background-color: #e74c3c; -fx-text-fill: white;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" onAction="#loadCustomerData"
                style="-fx-padding: 10 20; -fx-background-color: #95a5a6; -fx-text-fill: white;"/>
    </HBox>

    <StackPane fx:id="rightPane" minHeight="200">
    </StackPane>

</VBox>
