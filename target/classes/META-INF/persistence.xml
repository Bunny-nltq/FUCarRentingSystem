<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="FUCarPU">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.fucar.entity.Account</class>
        <class>com.fucar.entity.Customer</class>
        <class>com.fucar.entity.Car</class>
        <class>com.fucar.entity.CarProducer</class>
        <class>com.fucar.entity.CarRental</class>
        <class>com.fucar.entity.Review</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3307/FUCarRentingSystemDB?useSSL=false&amp;serverTimezone=UTC"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="123456"/>
            
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
