<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox spacing="15" alignment="CENTER" xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fucar.gui.controller.CarRentalManagementController"
      styleClass="root">

    <Label text="My Car Rentals" styleClass="label"/>

    <TableView fx:id="tableRentals" prefWidth="750" styleClass="table-view">
        <columns>
            <TableColumn text="Car" fx:id="colCarName"/>
            <TableColumn text="Start Date" fx:id="colStartDate"/>
            <TableColumn text="End Date" fx:id="colEndDate"/>
            <TableColumn text="Status" fx:id="colStatus"/>
            <TableColumn text="Cost" fx:id="colCost"/>
        </columns>
    </TableView>

    <HBox spacing="15" alignment="CENTER">  
        <Button fx:id="btnEdit" text="Edit" styleClass="button" onAction="#deleteRental"/>
        <Button fx:id="btnDelete" text="Delete" styleClass="button" onAction="#deleteRental"/>
        <Button fx:id="btnBack" text="Back" styleClass="button" onAction="#goBack"/>
    </HBox>
</VBox>
