<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fucar.gui.controller.ProfileController"
      alignment="CENTER"
      spacing="20">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <!-- TITLE -->
    <Label text="My Profile"
           style="-fx-font-size: 24px; -fx-font-weight: bold"/>

    <!-- FORM GRID -->
    <GridPane hgap="15" vgap="15">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="150"/>
            <ColumnConstraints halignment="LEFT" minWidth="250"/>
        </columnConstraints>

        <!-- FULL NAME -->
        <Label text="Full Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtName" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <!-- MOBILE -->
        <Label text="Mobile:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPhone" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <!-- IDENTITY CARD -->
        <Label text="Identity Card:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtIdentityCard" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <!-- BIRTHDAY -->
        <Label text="Birthday:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dateBirthday" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <!-- LICENCE NUMBER -->
        <Label text="Licence Number:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtLicenceNumber" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <!-- LICENCE DATE -->
        <Label text="Licence Date:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dateLicenceDate" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <!-- EMAIL -->
        <Label text="Email:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEmail"
                   editable="false"
                   style="-fx-opacity: 0.7;"
                   GridPane.rowIndex="6"
                   GridPane.columnIndex="1"/>
    </GridPane>

    <!-- SAVE BUTTON ONLY -->
    <Button fx:id="btnSave" text="Save Changes"
            style="-fx-padding: 8 25; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px"/>

</VBox>